# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client. Used for admin operations (CSV import validation,
# suppression checks across RLS boundaries in scheduled jobs, etc).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this deployment, no trailing slash. Used to build the Shortcut's
# callback URLs and the public opt-out link embedded in outgoing messages.
NEXT_PUBLIC_APP_URL=https://advance.yourdomain.com

# 32+ byte random secret used to sign short-lived Shortcut session tokens (HMAC).
# Generate with: openssl rand -hex 32
SHORTCUT_TOKEN_SECRET=change-me-to-a-long-random-string

# Same purpose, used to sign the public opt-out link tokens.
OPT_OUT_TOKEN_SECRET=change-me-to-a-different-long-random-string

# Name of the Shortcut the app links to (must match exactly what the user names it
# when they build it on their iPhone, see docs/APPLE_SHORTCUTS.md).
NEXT_PUBLIC_SHORTCUT_NAME=Advance Sender
